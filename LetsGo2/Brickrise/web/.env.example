# 복사해서 .env.local 로 쓰세요. (.env.local은 git에 올라가지 않습니다)

# 관리자 화면 비밀번호와 세션 서명용 비밀값 (운영 환경에서는 반드시 설정)
ADMIN_PASSWORD=
SESSION_SECRET=

# Postgres 연결 문자열. 비워 두면 메모리 저장소를 써서 서버를 재시작하면 데이터가 사라집니다(개발용).
# Vercel에서는 Marketplace의 Neon(Postgres)을 연결하면 자동으로 들어옵니다.
DATABASE_URL=

# Vercel Blob 토큰. 있으면 고객 사진 원본을 비공개(private)로 저장합니다.
# 비워 두면 개발 환경에서는 .data/photos 폴더에 저장하고, 운영 환경에서는 사진을 저장하지 않습니다.
BLOB_READ_WRITE_TOKEN=

# 네이버 스마트스토어 상품 페이지 주소 (주문 코드 발급 후 '네이버 스토어로 이동' 버튼)
NEXT_PUBLIC_NAVER_STORE_URL=

# 블럭 1개 무게(g). 작업지시서의 무게 환산에 쓰입니다. 비워 두면 표시하지 않습니다.
BLOCK_WEIGHT_G=
